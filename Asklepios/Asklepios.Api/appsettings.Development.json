{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "postgres": {
    "connectionString": "Host=localhost;Port=5432;Database=asklepios;Username=postgres;Password="
  },
  "redis": {
    "connectionString": "localhost:6379",
    "instanceName": "Asklepios_"
  },
